<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldOps.Mobile.ViewModels"
             x:Class="FieldOps.Mobile.Views.AgentPage"
             x:DataType="vm:AgentViewModel"
             Title="Assistant">
    <Grid RowDefinitions="*,Auto,Auto" Padding="20" RowSpacing="10">
        <CollectionView ItemsSource="{Binding Lines}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatLine">
                    <VerticalStackLayout Padding="0,6">
                        <Label Text="{Binding Who}" FontAttributes="Bold" FontSize="12" />
                        <Label Text="{Binding Text}" />
                        <Label Text="{Binding Tools}" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Entry Text="{Binding Message}" MaxLength="500"
                   Placeholder="e.g. Is the SK-200 seal kit in stock?"
                   ReturnCommand="{Binding SendCommand}" />
            <Button Grid.Column="1" Text="Send" Command="{Binding SendCommand}" />
        </Grid>
    </Grid>
</ContentPage>