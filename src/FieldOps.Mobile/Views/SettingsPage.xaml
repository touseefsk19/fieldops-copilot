<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:FieldOps.Mobile.ViewModels"
             x:Class="FieldOps.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Dev token (from dotnet user-jwts)" FontAttributes="Bold" />
        <Editor Text="{Binding Token}" Placeholder="Paste the JWT here" HeightRequest="120" />
        <Button Text="Save" Command="{Binding SaveCommand}" />
        <Label Text="{Binding Status}" />
    </VerticalStackLayout>
</ContentPage>